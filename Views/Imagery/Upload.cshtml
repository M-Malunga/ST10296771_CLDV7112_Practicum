@{
    ViewData["Title"] = "Upload Imagery";
}
<h2>Upload Drone Imagery</h2>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="mt-3">
    <div class="mb-3">
        <label class="form-label">Image file</label>
        <input id="fileInput" name="file" type="file"
               class="form-control" accept="image/*" />
    </div>

    <div id="previewWrap" class="mb-3 d-none">
        <label class="form-label">Preview</label>
        <div>
            <img id="previewImg" alt="Selected image preview"
                 class="img-thumbnail"
                 style="max-height:320px;max-width:100%;" />
        </div>
        <div id="previewInfo" class="text-muted small mt-1"></div>
    </div>

    <button type="submit" class="btn btn-primary">Upload</button>
    <a asp-action="Index" class="btn btn-link">View uploads</a>
</form>

@section Scripts {
    <script>
        (function() {
            const input = document.getElementById('fileInput');
            const wrap = document.getElementById('previewWrap');
            const img = document.getElementById('previewImg');
            const info = document.getElementById('previewInfo');
            let lastUrl = null;

            input.addEventListener('change', function() {
                const file = input.files && input.files[0];

                if (lastUrl) { URL.revokeObjectURL(lastUrl); lastUrl = null; }

                if (!file || !file.type.startsWith('image/')) {
                    wrap.classList.add('d-none');
                    img.removeAttribute('src');
                    return;
                }

                lastUrl = URL.createObjectURL(file);
                img.src = lastUrl;
                info.textContent = `${file.name} — ${(file.size / 1024).toFixed(1)} KB`;
                wrap.classList.remove('d-none');
            });
        })();
    </script>
}